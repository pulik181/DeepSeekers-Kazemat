; Engine configuration file.
; Казематы Дознания — Dark Fantasy Action-Detective RPG (Godot 4.7.2 Compatibility)

config_version=5

[application]

config/name="Казематы Дознания"
config/description="Тёмно-фэнтезийная детективно-боевая RPG с динамическим светом и ИИ-допросами"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

CaseManager="*res://autoload/case_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
AIInterrogator="*res://autoload/ai_interrogator.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

